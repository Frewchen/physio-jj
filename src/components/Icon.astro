---
// Linien-Icons aus lucide-static, direkt als SVG ins HTML eingebettet.
const icons = import.meta.glob<string>("/node_modules/lucide-static/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const svg = icons[`/node_modules/lucide-static/icons/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" nicht gefunden`);

// Nur das äußere <svg>-Tag anpassen – innere Formen (z. B. <rect width>) bleiben unverändert.
const html = svg
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<svg[^>]*>/, (tag) =>
    tag
      .replace(/\s(width|height|class)="[^"]*"/g, "")
      .replace("<svg", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ""}`),
  );
---

<Fragment set:html={html} />
