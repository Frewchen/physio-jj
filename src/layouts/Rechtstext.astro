---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} – Physiotherapie Jeannette Jasinski`} description={description}>
  <Header />
  <div class="container rahmen">
    <main class="text">
      <h1>{title}</h1>
      <slot />
    </main>
  </div>
  <Footer />
</Base>

<style>
  .rahmen {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 4rem;
  }
  .text {
    max-width: 720px;
    margin-top: clamp(1.5rem, 5vw, 3rem);
  }
  .text :global(h1) {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    margin-bottom: 2rem;
  }
  .text :global(h2) {
    font-size: clamp(1.5rem, 3.5vw, 1.9rem);
    margin: 2.75rem 0 0.75rem;
  }
  .text :global(h3) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    margin: 1.75rem 0 0.4rem;
  }
  .text :global(p),
  .text :global(ul) {
    margin: 0 0 1rem;
  }
  .text :global(ul) {
    padding-left: 1.2rem;
  }
  .text :global(li) {
    margin-bottom: 0.35rem;
  }
  .text :global(a) {
    color: var(--red-dark);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .text :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }
</style>
