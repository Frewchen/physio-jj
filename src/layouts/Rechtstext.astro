---
import { Image } from "astro:assets";
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import logo from "../assets/logo.png";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} – Physiotherapie Jeannette Jasinski`} description={description}>
  <div class="rahmen">
    <header class="kopf">
      <a href="/" aria-label="Zur Startseite">
        <Image src={logo} alt="Physiotherapie Jeannette Jasinski" width={240} class="logo" />
      </a>
      <a class="zurueck" href="/">← Zur Startseite</a>
    </header>

    <main class="text">
      <h1>{title}</h1>
      <slot />
    </main>
  </div>
  <Footer />
</Base>

<style>
  .rahmen {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) 16px 4rem;
  }
  .kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .logo {
    width: clamp(180px, 30vw, 240px);
    height: auto;
  }
  .zurueck {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }
  .zurueck:hover {
    color: var(--red);
  }

  .text {
    max-width: 720px;
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
  }
  .text :global(h1) {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    margin-bottom: 2rem;
  }
  .text :global(h2) {
    font-size: clamp(1.5rem, 3.5vw, 1.9rem);
    margin: 2.75rem 0 0.75rem;
  }
  .text :global(h3) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    margin: 1.75rem 0 0.4rem;
  }
  .text :global(p),
  .text :global(ul) {
    margin: 0 0 1rem;
  }
  .text :global(ul) {
    padding-left: 1.2rem;
  }
  .text :global(li) {
    margin-bottom: 0.35rem;
  }
  .text :global(a) {
    color: var(--red-dark);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .text :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }
</style>
