---
// Schriften werden lokal ausgeliefert (kein Google-Fonts-CDN, DSGVO-freundlich).
import "@fontsource-variable/jost";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
import { url, istVorschau } from "../lib/url";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {istVorschau ? <meta name="robots" content="noindex, nofollow, noarchive" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="theme-color" content="#faf6f3" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
  </head>
  <body>
    {istVorschau && <div class="vorschau-hinweis">Vorschau – nicht veröffentlicht</div>}
    <slot />
    <script>
      const elemente = document.querySelectorAll(".einblenden");
      if ("IntersectionObserver" in window) {
        const beobachter = new IntersectionObserver(
          (eintraege) => {
            for (const e of eintraege) {
              if (e.isIntersecting) {
                e.target.classList.add("sichtbar");
                beobachter.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        elemente.forEach((el) => beobachter.observe(el));
      } else {
        elemente.forEach((el) => el.classList.add("sichtbar"));
      }
    </script>
  </body>
</html>
