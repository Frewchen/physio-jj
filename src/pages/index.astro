---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Email from "../components/Email.astro";
import Icon from "../components/Icon.astro";
import zeichen from "../assets/zeichen.png";
import { praxis } from "../data/praxis";
import { leistungsGruppen, beschwerden, ansatz, ablauf, mitbringen } from "../data/inhalte";

const { lat, lng } = praxis.geo;
const osmLink = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=17/${lat}/${lng}`;
const osmEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - 0.008}%2C${lat - 0.0035}%2C${lng + 0.008}%2C${lat + 0.0035}&layer=mapnik&marker=${lat}%2C${lng}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Physiotherapy",
  name: praxis.name,
  url: "https://physiotherapie-jasinski.de",
  telephone: "+49 40 32081471",
  address: {
    "@type": "PostalAddress",
    streetAddress: praxis.strasse,
    postalCode: praxis.plz,
    addressLocality: praxis.ort,
    addressCountry: "DE",
  },
  geo: { "@type": "GeoCoordinates", latitude: lat, longitude: lng },
};
import { url } from "../lib/url";
---

<Base
  title="Physiotherapie Jeannette Jasinski – Physiotherapie & GesundheitsCoaching in Hamburg"
  description="Physiotherapie in Hamburg: Krankengymnastik, Manuelle Therapie, Lymphdrainage, Faszientherapie, Massage, Hausbesuche und mentales GesundheitsCoaching bei Jeannette Jasinski."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main>
    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="container hero-raster">
        <div class="hero-text">
          <p class="eyebrow">Physiotherapie in Hamburg</p>
          <h1>Wenn Bewegung wieder <em>Spaß&nbsp;macht.</em></h1>
          <p class="einleitung">
            Ich begleite Sie mit Physiotherapie, Massage und mentalem GesundheitsCoaching zurück
            zu mehr Beweglichkeit, weniger Schmerzen und neuer Lebensqualität – in meiner Praxis
            oder bei Ihnen zu Hause.
          </p>
          <div class="aktionen">
            <a class="btn btn-primaer" href={praxis.telefon.href}>
              <Icon name="phone" size={18} />
              Termin vereinbaren
            </a>
            <a class="btn btn-sekundaer" href="#leistungen">Leistungen ansehen</a>
          </div>
        </div>

        <div class="hero-bild" aria-hidden="true">
          <div class="sonne"></div>
          <div class="schwebe schwebe-1">
            <span class="schwebe-icon"><Icon name="calendar-check" size={20} /></span>
            <span><strong>Seit 2015</strong><br />Physiotherapeutin</span>
          </div>
          <div class="schwebe schwebe-2">
            <span class="schwebe-icon"><Icon name="house-heart" size={20} /></span>
            <span><strong>Hausbesuche</strong><br />in Hamburg</span>
          </div>
          <div class="schwebe schwebe-3">
            <span class="schwebe-icon"><Icon name="brain" size={20} /></span>
            <span><strong>Körper & Kopf</strong><br />ganzheitlich</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ÜBER MICH ═══ -->
    <section class="abschnitt ueber" id="ueber-mich">
      <div class="container ueber-raster">
        <figure class="portrait einblenden">
          <!-- PRÜFEN: Hier kommt ein Porträtfoto von Jeannette hinein. -->
          <div class="portrait-platzhalter">
            <Image src={zeichen} alt="" width={180} densities={[1, 1.35]} />
            <span>Porträtfoto folgt</span>
          </div>
          <figcaption>
            <strong>Jeannette Jasinski</strong>
            Staatlich anerkannte Physiotherapeutin & Mentaler GesundheitsCoach
          </figcaption>
        </figure>

        <div class="einblenden">
          <p class="eyebrow">Über mich</p>
          <h2 class="titel">Hallo, ich bin <em>Jeannette.</em></h2>
          <p class="einleitung">
            Ich bin staatlich anerkannte Physiotherapeutin in Hamburg. Seit dem Abschluss meiner
            Ausbildung im Jahr 2015 bin ich für viele Menschen Ansprechpartnerin rund um Bewegung,
            Krankengymnastik, Massage und das gesamte Spektrum des Bewegungsapparates.
          </p>
          <p>
            2019 habe ich zusätzlich eine Ausbildung zum Mentalen GesundheitsCoach abgeschlossen.
            Dieses Wissen fließt in meine Therapien ein – und ich biete mentales GesundheitsCoaching
            auch als eigenes Angebot an. So können wir gemeinsam innere Blockaden lösen, die Ihre
            Genesung beeinträchtigen.
          </p>
          <blockquote>
            Das Ziel einer erfolgreichen Therapie ist, Ihr Wohlbefinden und Ihre Lebensqualität
            wiederherzustellen.
          </blockquote>
          <ul class="meilensteine">
            <li><span>2015</span> Staatlich anerkannte Physiotherapeutin</li>
            <li><span>2019</span> Ausbildung zum Mentalen GesundheitsCoach</li>
            <li><span>Heute</span> Eigene Praxis in Hamburg & Hausbesuche</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ BESCHWERDEN ═══ -->
    <section class="abschnitt beschwerden" id="beschwerden">
      <div class="container beschwerden-raster">
        <div class="einblenden">
          <p class="eyebrow">Wobei ich helfe</p>
          <h2 class="titel">Rückenschmerzen sind eine echte <em>Volkskrankheit.</em></h2>
          <p class="einleitung">
            Oft lässt sich keine eindeutige Ursache feststellen. Häufig stecken
            Muskelverspannungen, Wirbelblockaden, Bandscheibenvorfälle oder Gelenkbeschwerden
            dahinter.
          </p>
          <p>
            Doch nicht nur der Rücken schränkt im Alltag ein. Ich behandle das gesamte Spektrum des
            Bewegungsapparates – zum Beispiel bei diesen Beschwerden:
          </p>
        </div>
        <div class="einblenden">
          <div class="statistik">
            <span class="zahl">20&nbsp;Mio.</span>
            <span>Menschen gehen in Deutschland jedes Jahr wegen Rückenschmerzen zum Arzt.</span>
          </div>
          <ul class="beschwerde-liste">
            {beschwerden.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ LEISTUNGEN ═══ -->
    <section class="abschnitt leistungen" id="leistungen">
      <div class="container">
        <div class="kopf-mittig einblenden">
          <p class="eyebrow">Leistungen</p>
          <h2 class="titel">Mein <em>Therapieangebot</em></h2>
          <p class="einleitung">
            Ein umfangreiches Angebot zur Genesung, Entspannung und Vorbeugung – abgestimmt auf
            Ihre Beschwerden und Ihre Ziele.
          </p>
        </div>

        {
          leistungsGruppen.map((gruppe) => (
            <div class="gruppe">
              <div class="gruppe-kopf einblenden">
                <h3>{gruppe.titel}</h3>
                <p>{gruppe.intro}</p>
              </div>
              <div class="karten" data-anzahl={gruppe.leistungen.length}>
                {gruppe.leistungen.map((l) => (
                  <article class="karte einblenden">
                    <span class="karte-icon">
                      <Icon name={l.icon} size={22} />
                    </span>
                    <h4>{l.titel}</h4>
                    <p>{l.text}</p>
                  </article>
                ))}
              </div>
            </div>
          ))
        }

        <aside class="hausbesuch einblenden">
          <span class="hausbesuch-icon"><Icon name="house-heart" size={30} /></span>
          <div>
            <h3>Hausbesuche</h3>
            <p>
              Sie können nicht in die Praxis kommen? Dann komme ich zu Ihnen nach Hause.
              Sprechen Sie mich einfach an.
            </p>
          </div>
          <a class="btn btn-primaer" href={praxis.telefon.href}>Hausbesuch anfragen</a>
        </aside>
      </div>
    </section>

    <!-- ═══ ANSATZ ═══ -->
    <section class="abschnitt ansatz" id="ansatz">
      <div class="container">
        <div class="kopf-mittig einblenden">
          <p class="eyebrow">Mein Ansatz</p>
          <h2 class="titel">Ganzheitlich – für <em>Körper</em> und <em>Kopf</em></h2>
          <p class="einleitung">
            Körperliche Beschwerden hängen oft mit Stress, Gewohnheiten und inneren Blockaden
            zusammen. Deshalb betrachte ich Sie als ganzen Menschen.
          </p>
        </div>
        <div class="saeulen">
          {
            ansatz.map((a) => (
              <div class="saeule einblenden">
                <Icon name={a.icon} size={30} />
                <h3>{a.titel}</h3>
                <p>{a.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ ABLAUF ═══ -->
    <section class="abschnitt ablauf" id="ablauf">
      <div class="container ablauf-raster">
        <div class="einblenden">
          <p class="eyebrow">So läuft es ab</p>
          <h2 class="titel">Ihr Weg zu <em>mehr Bewegung</em></h2>
          <div class="mitbringen">
            <h3><Icon name="clipboard-list" size={20} /> Bitte mitbringen</h3>
            <ul>
              {mitbringen.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        </div>
        <ol class="schritte">
          {
            ablauf.map((s, i) => (
              <li class="einblenden">
                <span class="nummer">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{s.titel}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ═══ KONTAKT ═══ -->
    <section class="abschnitt kontakt" id="kontakt">
      <div class="container">
        <div class="kopf-mittig einblenden">
          <p class="eyebrow">Kontakt & Anfahrt</p>
          <h2 class="titel">Ich freue mich auf <em>Sie.</em></h2>
          <p class="einleitung">
            Termine vereinbaren Sie am besten telefonisch. Ist die Leitung besetzt, rufe ich Sie
            gern zurück.
          </p>
        </div>

        <div class="kontakt-raster">
          <div class="kontakt-karte einblenden">
            <a class="zeile" href={praxis.telefon.href}>
              <span class="zeile-icon"><Icon name="phone" size={20} /></span>
              <span><small>Telefon Praxis</small>{praxis.telefon.anzeige}</span>
            </a>
            <a class="zeile" href={praxis.mobil.href}>
              <span class="zeile-icon"><Icon name="phone" size={20} /></span>
              <span><small>Mobil</small>{praxis.mobil.anzeige}</span>
            </a>
            <div class="zeile">
              <span class="zeile-icon"><Icon name="mail" size={20} /></span>
              <span><small>E-Mail</small><Email /></span>
            </div>
            <a class="zeile" href={osmLink} target="_blank" rel="noopener">
              <span class="zeile-icon"><Icon name="map-pin" size={20} /></span>
              <span><small>Adresse</small>{praxis.strasse}, {praxis.plz} {praxis.ort}</span>
            </a>
            <div class="zeile">
              <span class="zeile-icon"><Icon name="clock" size={20} /></span>
              <!-- PRÜFEN: Sprechzeiten ergänzen, falls gewünscht -->
              <span><small>Termine</small>Nach Vereinbarung</span>
            </div>
            <a class="btn btn-primaer voll" href={praxis.telefon.href}>
              <Icon name="phone" size={18} /> Jetzt anrufen
            </a>
          </div>

          <div class="karte-osm einblenden" id="karte" data-src={osmEmbed}>
            <div class="karte-hinweis">
              <Icon name="map-pin" size={34} />
              <p><strong>{praxis.strasse}</strong><br />{praxis.plz} {praxis.ort}</p>
              <button class="btn btn-sekundaer" type="button" id="karte-laden">Karte anzeigen</button>
              <small>
                Beim Laden der Karte werden Daten an OpenStreetMap übertragen.{" "}
                <a href={url("/datenschutz/#karte")}>Mehr erfahren</a>
              </small>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const karte = document.getElementById("karte");
  document.getElementById("karte-laden")?.addEventListener("click", () => {
    if (!karte) return;
    const iframe = document.createElement("iframe");
    iframe.src = karte.dataset.src!;
    iframe.title = "Karte: Lage der Praxis";
    iframe.loading = "lazy";
    karte.replaceChildren(iframe);
    karte.classList.add("geladen");
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(4rem, 9vw, 7rem);
  }
  .hero-raster {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    letter-spacing: -0.015em;
  }
  h1 em {
    color: var(--red);
    font-style: italic;
  }
  .aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-bild {
    position: relative;
    aspect-ratio: 1;
    max-width: 500px;
    width: 100%;
    justify-self: end;
  }
  .sonne {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background:
      repeating-linear-gradient(-28deg, transparent 0 38px, rgb(255 255 255 / 0.5) 38px 44px) top left / 100% 46% no-repeat,
      radial-gradient(circle at 35% 30%, #ef3a3f, var(--red) 55%, var(--red-dark));
    box-shadow: 0 40px 80px -30px rgb(168 9 13 / 0.55);
    animation: schweben 9s ease-in-out infinite alternate;
  }
  .schwebe {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    border-radius: 16px;
    box-shadow: var(--shadow);
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--muted);
    animation: schweben 7s ease-in-out infinite alternate;
  }
  .schwebe strong {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .schwebe-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--red-soft);
    color: var(--red);
    flex-shrink: 0;
  }
  .schwebe-1 {
    top: 10%;
    left: -6%;
  }
  .schwebe-2 {
    top: 46%;
    right: -4%;
    animation-delay: -2s;
  }
  .schwebe-3 {
    bottom: 6%;
    left: 6%;
    animation-delay: -4s;
  }
  @keyframes schweben {
    to {
      transform: translateY(-12px);
    }
  }

  /* ── Über mich ── */
  .ueber {
    background: var(--paper);
  }
  .ueber-raster {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .portrait {
    margin: 0;
  }
  .portrait-platzhalter {
    aspect-ratio: 4 / 5;
    border-radius: 28px 120px 28px 28px;
    background: linear-gradient(160deg, #fdf1ef, #f6dcd8);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .portrait-platzhalter img {
    width: 45%;
    opacity: 0.9;
  }
  .portrait figcaption {
    margin-top: 1.1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .portrait figcaption strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--ink);
  }
  blockquote {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--red);
    background: var(--red-soft);
    border-radius: 0 14px 14px 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--red-dark);
  }
  .meilensteine {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .meilensteine li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .meilensteine span {
    min-width: 3.6rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--red);
  }

  /* ── Beschwerden ── */
  .beschwerden-raster {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .statistik {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: rgb(255 255 255 / 0.75);
    margin-bottom: 1.5rem;
  }
  .zahl {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 4.4rem);
    line-height: 1;
    color: #fff;
  }
  .beschwerde-liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .beschwerde-liste li {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-size: 0.93rem;
  }

  /* ── Leistungen ── */
  .leistungen {
    background: var(--paper);
  }
  .kopf-mittig {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
  }
  .kopf-mittig .einleitung {
    margin-left: auto;
    margin-right: auto;
  }
  .gruppe + .gruppe {
    margin-top: 3rem;
  }
  .gruppe-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .gruppe-kopf h3 {
    font-size: 1.8rem;
  }
  .gruppe-kopf p {
    margin: 0;
    color: var(--muted);
  }
  /* 12er-Raster: 3 oder 4 Karten pro Reihe; bei 5 Karten 3 + 2 breitere */
  .karten {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
  }
  .karten > .karte {
    grid-column: span 4;
  }
  .karten[data-anzahl="4"] > .karte {
    grid-column: span 3;
  }
  .karten[data-anzahl="5"] > .karte:nth-child(n + 4) {
    grid-column: span 6;
  }
  .karte {
    padding: 1.6rem;
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid transparent;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s, background 0.25s;
  }
  .karte:hover {
    background: var(--paper);
    border-color: var(--line);
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }
  .karte-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--red-soft);
    color: var(--red);
    margin-bottom: 1.1rem;
  }
  .karte h4 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.35;
  }
  .karte p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .hausbesuch {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.75rem 2rem;
    border-radius: var(--radius);
    background: linear-gradient(120deg, var(--red), var(--red-dark));
    color: rgb(255 255 255 / 0.88);
  }
  .hausbesuch > div {
    flex: 1 1 300px;
  }
  .hausbesuch h3 {
    color: #fff;
    font-size: 1.8rem;
  }
  .hausbesuch p {
    margin: 0.3rem 0 0;
  }
  .hausbesuch-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
  }
  .hausbesuch .btn {
    background: #fff;
    color: var(--red-dark);
    box-shadow: none;
  }
  .hausbesuch .btn:hover {
    background: var(--cream);
  }

  /* ── Ansatz ── */
  .ansatz {
    background: var(--ink);
    color: rgb(255 255 255 / 0.7);
  }
  .ansatz .titel {
    color: #fff;
  }
  .ansatz .titel em,
  .ansatz .eyebrow {
    color: #ff6b6b;
  }
  .ansatz .einleitung {
    color: rgb(255 255 255 / 0.65);
  }
  .saeulen {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .saeule {
    padding: 2rem 1.6rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition: background 0.25s;
  }
  .saeule:hover {
    background: rgb(212 13 18 / 0.14);
  }
  .saeule :global(svg) {
    color: #ff6b6b;
  }
  .saeule h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.6rem;
    color: #fff;
  }
  .saeule p {
    margin: 0;
    font-size: 0.95rem;
  }

  /* ── Ablauf ── */
  .ablauf-raster {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
